#!/usr/bin/env bash
set -euo pipefail

agent_mount=/agent
active_file=$agent_mount/boot/active-instance

mountpoint -q "$agent_mount"
test -s "$active_file"

instance_id=$(tr -d '\r\n' <"$active_file")
[[ "$instance_id" =~ ^[A-Za-z0-9._-]+$ ]]

instance_root=$agent_mount/lives/$instance_id
executable=$instance_root/body/bin/hominald
test -x "$executable"
test -d "$instance_root/body/organs"

# /life is a body surface, so ordinary directory tools must observe it as a
# directory.  The per-generation storage location is an implementation detail;
# exposing it as a symlink made `find /life` silently inspect only the link and
# repeatedly taught a false environmental fact.  Reset unmounts the previous
# generation before changing active-instance, so an existing mount here belongs
# to this same generation and can be reused after a service restart.
life_source=$instance_root/life
life_surface=/life
test -d "$life_source"
if [[ -L "$life_surface" ]]; then
  rm -f -- "$life_surface"
fi
install -d -m 0755 "$life_surface"
if ! mountpoint -q "$life_surface"; then
  mount --bind "$life_source" "$life_surface"
fi

install -d -m 0755 "$agent_mount/state"

export HOMINAL_INSTANCE_ID="$instance_id"
export HOMINAL_INSTANCE_ROOT="$instance_root"
export HOMINAL_RESOURCE_LEDGER="$agent_mount/state/cognitive-usage.jsonl"
export PATH="$instance_root/body/bin:$PATH"
cd "$instance_root"

# hominald owns the lifecycle of every Manifest-declared organ. The launcher
# prepares only the common runtime surface and never starts a concrete adapter.
install -d -m 0755 /run/hominal/organs "$instance_root/logs"

exec "$executable"
