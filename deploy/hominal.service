[Unit]
Description=Hominal active body
After=local-fs.target network-online.target
Wants=network-online.target
RequiresMountsFor=/agent
ConditionPathIsMountPoint=/agent
ConditionPathExists=/agent/boot/active-instance

[Service]
Type=simple
ExecStart=/usr/local/sbin/hominal-launcher
Restart=always
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
