[Unit]
Description=Hominal same-session VNC for Xorg display :0
After=display-manager.service agent.mount
Wants=display-manager.service
RequiresMountsFor=/agent

[Service]
Type=simple
ExecStart=/usr/bin/x11vnc -display :0 -auth guess -forever -shared -localhost -rfbport 5900 -rfbauth /agent/state/security/x11vnc.pass -noxdamage -repeat
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
